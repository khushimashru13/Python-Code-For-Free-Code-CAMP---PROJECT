def hanoi_solver(n):
    rods = [
        list(range(n, 0, -1)),
        [],
        []
    ]

    moves = []

    def record():
        moves.append(
            f"{rods[0]} {rods[1]} {rods[2]}"
        )

    def move_disks(number, source, target, auxiliary):
        if number == 0:
            return

        # Move n-1 disks to auxiliary rod
        move_disks(number - 1, source, auxiliary, target)

        # Move the top disk to target rod
        disk = rods[source].pop()
        rods[target].append(disk)

        record()

        # Move n-1 disks from auxiliary to target
        move_disks(number - 1, auxiliary, target, source)

    # Starting arrangement
    record()

    # Solve the puzzle
    move_disks(n, 0, 2, 1)

    return "\n".join(moves)
